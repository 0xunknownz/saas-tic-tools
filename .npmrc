# Foundation npm packages are hosted on GitHub Packages (design 4.2/5.3).
# pnpm 10 does not expand ${NODE_AUTH_TOKEN} in a project .npmrc (it could leak a committed token).
# CI and image builds write the same lines to the user-level ~/.npmrc; locally do the same:
#   printf '@0xunknownz:registry=https://npm.pkg.github.com\n//npm.pkg.github.com/:_authToken=%s\n' "$NODE_AUTH_TOKEN" >> ~/.npmrc
# (`pnpm config set` writes pnpm's own auth store, which pnpm 10 does not read.)
@0xunknownz:registry=https://npm.pkg.github.com
always-auth=true
