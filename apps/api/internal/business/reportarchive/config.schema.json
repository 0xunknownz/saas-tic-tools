{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ocrProvider": {
      "type": "string",
      "enum": [
        "disabled",
        "ocrspace"
      ]
    },
    "ocrEndpoint": {
      "type": "string"
    },
    "ocrAPIKey": {
      "type": "string"
    },
    "ocrModel": {
      "type": "string"
    },
    "ocrTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "ocrMaxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "pollMilliseconds": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "retryBaseSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "maxUploadBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxUploadFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxPDFPages": {
      "type": "integer",
      "minimum": 1
    }
  }
}
