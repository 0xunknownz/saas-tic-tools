# Test-environment deployment variables. Copy to deploy/.env and edit; never commit deploy/.env.
# This template is only for the single-host TEST environment and test data (PRD AC-027).
COMPOSE_PROJECT_NAME=saas-tic-tools-test

# Host-side connection used by "go tool saasctl db migrate" in deploy/scripts/up.sh. Use 127.0.0.1 and the
# POSTGRES_PORT below; keep the password URL-safe (letters, digits, . _ ~ -).
# Build-time only: a read-only token that can read the private Foundation repository. It is mounted
# as a BuildKit secret for the image build and never stored in an image or image layer. Leave it empty
# only when the build uses a vendored Foundation tree (offline delivery).
FOUNDATION_READ_TOKEN=

# Read-only GitHub Packages token for @0xunknownz/foundation-* (needs read:packages). Build-time only;
# mounted as a BuildKit secret for the web/edge image builds and never stored in an image.
NODE_AUTH_TOKEN=

# Replace the password in MIGRATE_DATABASE_URL and in POSTGRES_PASSWORD below with the same value.
MIGRATE_DATABASE_URL=postgres://saas_tic_tools:SET_A_TEST_PASSWORD@127.0.0.1:5432/saas_tic_tools?sslmode=disable

# PostgreSQL (test data only).
POSTGRES_DB=saas_tic_tools
POSTGRES_USER=saas_tic_tools
# Set a test-only password. Keep it URL-safe (letters, digits, . _ ~ -); no real secrets here.
POSTGRES_PASSWORD=
# (the value is intentionally empty; fill it in deploy/.env)

POSTGRES_PORT=5432

# Public entry point (the nginx edge).
HTTP_PORT=8080
WEB_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:8080/admin

# Test environment images. Build them with "docker compose -f deploy/compose/test.yaml build" (or
# deploy/scripts/up.sh, which builds the Release Manifest first).
API_IMAGE=saas-tic-tools-api:test
WEB_IMAGE=saas-tic-tools-web:test
EDGE_IMAGE=saas-tic-tools-edge:test
TARGET_PLATFORM=linux/amd64

# 32 random bytes, base64: openssl rand -base64 32
# Required: the API seals TOTP material and signs download links with it. Fill this in deploy/.env.
SECRETS_KEY=

# Storage: local is allowed for test/development only (11.15).
STORAGE_PROVIDER=local
STORAGE_MAX_FILE_SIZE=100MB

# Notification (disabled for the test environment; the outbox still records messages).
NOTIFICATION_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Product switches; environment variables override product.yaml at runtime.
TENANT_SELF_SIGNUP=true
TENANT_SELF_SERVICE_CREATE=false

# Report archive OCR (PaddleOCR official API). REPORT_OCR_API_KEY is required when the provider is
# paddleocr: set it in deploy/.env from the AI Studio Access Token page. Never commit the token or
# put it in an image layer. Use REPORT_OCR_PROVIDER=disabled only when running without OCR.
REPORT_OCR_PROVIDER=paddleocr
REPORT_OCR_ENDPOINT=https://paddleocr.aistudio-app.com
REPORT_OCR_API_KEY=
REPORT_OCR_MODEL=PP-OCRv6
REPORT_OCR_TIMEOUT_SECONDS=300
REPORT_OCR_MAX_CONCURRENCY=2
REPORT_WORKER_POLL_MS=1000
REPORT_RETRY_BASE_SECONDS=5
REPORT_MAX_UPLOAD_BYTES=50000000
REPORT_MAX_UPLOAD_FILES=50
REPORT_MAX_PDF_PAGES=100

# Migration lock timeout for the one-shot migrate service.
MIGRATION_LOCK_TIMEOUT=30s
